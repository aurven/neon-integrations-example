{
  "version": 1,
  "_note": "Any 'env:VAR_NAME' reference anywhere in an environment entry whose variable is unset (or empty) invalidates that WHOLE entry, not just the field that used it — even an optional field like extApiKeyLimited below. The entry is skipped entirely (see the startup log) rather than partially loaded.",
  "adminApiKey": "env:NEON_EXT_APIKEY",
  "environments": [
    {
      "id": "demorc",
      "label": "Demo RC",
      "default": false,
      "hosts": ["neon-app-demorc.example.com"],
      "extApiKey": "env:DEMORC_EXT_APIKEY",
      "extApiKeyLimited": "env:DEMORC_EXT_APIKEY_LIMITED",
      "warmup": true,
      "insecureWebhook": false,
      "_insecureWebhook": "true = POST /in/neon/webhook/legacy?env=<id> accepted WITHOUT apikey (known insecure fallback)",
      "neon": {
        "insecureTls": false,
        "app": {
          "url": "https://neon-app-demorc.example.com"
        },
        "bo": {
          "url": "https://neon-bo-demorc.example.com/api",
          "apiKey": "env:DEMORC_BO_APIKEY",
          "userApiKey": "env:DEMORC_USER_APIKEY"
        },
        "fo": {
          "apiKey": "env:DEMORC_FO_APIKEY",
          "sites": {
            "theglobe": {
              "live": "https://theglobe-demorc.example.com",
              "preview": "https://preview-theglobe-demorc.example.com"
            }
          }
        }
      },
      "services": {
        "telegram": {
          "botToken": "env:DEMORC_TELEGRAM_BOT_TOKEN",
          "chatIds": {
            "default": "env:DEMORC_TELEGRAM_CHAT_ID"
          }
        }
      }
    }
  ]
}
