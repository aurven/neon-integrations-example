<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{seo.title}}</title>
  <!-- Neon design tokens (Source Sans 3, CSS vars) -->
  <link rel="stylesheet" href="/css/neon-design-system.css">
  <link rel="stylesheet" href="/neon/api/demo-integration/css/neon-design-system.css">
  <!-- Widget bundle CSS -->
  <link rel="stylesheet" href="/js/react/taxonomy-builder.css">
  <link rel="stylesheet" href="/neon/api/demo-integration/js/react/taxonomy-builder.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg-app, #f9f9fb); }
  </style>
</head>
<body>
  <div id="root"></div>

  <script>
    window.CONFIG = {
      apiKey: '{{{apiKey}}}',
      demo: {{demo}},
      neonEnv: {{{neonEnvJson}}}
    };
  </script>
  <!-- dual-path JS: the double-mount guard in main.jsx prevents a second mount -->
  <script src="/js/react/taxonomy-builder.js"></script>
  <script src="/neon/api/demo-integration/js/react/taxonomy-builder.js"></script>
</body>
</html>
